{
	"framework": "nextjs",
	"buildCommand": "cd ../.. && pnpm build",
	"installCommand": "cd ../.. && pnpm install --frozen-lockfile",
	"outputDirectory": ".next",
	"ignoreCommand": "exit 1",
	"git": {
		"deploymentEnabled": {
			"main": false
		}
	},
	"crons": [
		{
			"path": "/api/cron/chore-reminders",
			"schedule": "0 8 * * *"
		},
		{
			"path": "/api/cron/recurring-advance",
			"schedule": "10 6 * * *"
		},
		{
			"path": "/api/cron/event-reminders",
			"schedule": "0 9 * * *"
		},
		{
			"path": "/api/cron/maintenance",
			"schedule": "45 4 * * *"
		}
	]
}
