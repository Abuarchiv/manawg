# ============================================================
# apps/web — Environment Variables
# ============================================================
# Stack: Next.js + Supabase Auth (eu-central) + S3 image uploads.
#
# PUBLIC keys (NEXT_PUBLIC_*): embedded in the client bundle.
# SERVER-ONLY keys: API routes only.
#
# After provisioning Supabase + S3, pull with:
#   vercel env pull apps/web/.env.local
# ============================================================

# === App ====================================================
# Public app URL — used for invite links, OG images, robots, sitemap.
NEXT_PUBLIC_APP_URL=https://manawg.com

# === Supabase Auth ==========================================
# Public values used by the browser client and OAuth callback.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# === Database ===============================================
# POSTGRES_URL is the Supavisor Transaction Pooler connection (port 6543).
# DATABASE_URL is the supported alias (db/index.ts falls back to it).
# DATABASE_MIGRATION_URL is the Supabase Direct or Session Pooler connection (port 5432).
# Used for Drizzle DDL/migrations and transactions requiring session semantics. Must not use port 6543.
# For local development, omit the port or use port 5432.
POSTGRES_URL=postgres://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require
DATABASE_MIGRATION_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# === Migration mode =========================================
# Set to true during the database migration window to block all writes.
# /api/wg, /api/cron/* and all mutation endpoints return 503.
# /api/wg/<code> GET and /api/health remain available.
MIGRATION_READ_ONLY=false

# === S3 / Uploads ===========================================
# AWS S3 is used for image hosting (avatars, chat attachments).
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are server-only secrets.
# S3_PUBLIC_URL is the read-only CDN/origin URL prefix and is also
# enforced by the image-URL validator on the server.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# === Rate limiting (Upstash) — optional ======================
# When unset, rate-limit fails open (dev-friendly, unthrottled).
# Response-replay idempotency is Postgres-backed regardless of this —
# it does not depend on Upstash being configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Notifications: Web Push ================================
# Generate VAPID keys with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@manawg.com

# === Cron =====================================================
# Required in production: /api/cron/* routes fail-closed (503) without it.
# Optional for local dev.
CRON_SECRET=

# === Member sessions =========================================
# REQUIRED in production. Signs the per-member session token
# (HMAC-SHA256) that proves a request's x-manawg-member-id header is not
# spoofed. Gates admin-only WG mutations (delete WG, rename, rotate share
# code, toggle joining) — without it those endpoints reject every request
# with 403 rather than falling back to unsigned auth. Generate with:
#   openssl rand -hex 32
MEMBER_SESSION_SECRET=

# === PWA / Mobile (native deep-links) =======================
# Required for the iOS / Android well-known association files
# served by app/.well-known/apple-app-site-association/route.ts
# and app/.well-known/assetlinks.json/route.ts.
# When unset, the routes return empty associations (safe default).
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
