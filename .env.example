# ManaWG with Docker: settings for compose.yaml (docs/self-hosting.md).
# ./docker/setup.sh copies this file to .env and fills in the secrets. App development uses
# apps/web/.env.example instead.

# === Address =================================================
# The URL people open. Local: http://localhost (with HTTP_PORT=8080: http://localhost:8080).
APP_URL=http://localhost
# What the gateway listens on. ":80" serves plain HTTP: use it for http://localhost or behind a
# reverse proxy that terminates TLS. A domain such as "wg.example.com" gets HTTPS with a Let's
# Encrypt certificate (TCP ports 80 and 443 open, UDP 443 optional, for HTTP/3). Every address
# except localhost needs HTTPS: password reset, the service worker and app install require it.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# Interface the ports are published on, with a trailing colon. 127.0.0.1: keeps the gateway
# reachable from this host only (a reverse proxy on the same host); empty serves every interface,
# IPv4 and IPv6.
HTTP_BIND=
# Behind your own reverse proxy: its address range (e.g. private_ranges), so the app sees https
# and the client address. Without the proxy listed here, all visitors share one rate limit.
TRUSTED_PROXIES=127.0.0.1/32

# === Image ===================================================
# MANAWG_VERSION selects the image tag. Compose pulls it when that tag exists in the registry and
# otherwise builds the image from this checkout.
MANAWG_VERSION=latest
# Image repository, for a fork or a private registry.
# MANAWG_IMAGE=ghcr.io/abuarchiv/manawg-app

# === Mail (required) =========================================
# Sign-in codes, confirmations, invitations and statements go out over SMTP.
# Locally the "mailpit" profile catches every mail at http://localhost:8025.
COMPOSE_PROFILES=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
# Put values that contain $ or # in single quotes, e.g. SMTP_PASS='pa$$word'.
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@example.com
SMTP_SENDER_NAME=ManaWG

# === Your instance ===========================================
# Site with your /impressum, /datenschutz and /agb. Empty: the app and its mails show no legal
# links and no consent links. Set it before anyone else uses the instance.
LEGAL_URL=
# Receives "Fehler per E-Mail melden". Empty: SMTP_ADMIN_EMAIL.
SUPPORT_EMAIL=
# Name of the image storage bucket. Do not change it after the first start.
STORAGE_BUCKET=private-images

# === Secrets (filled in by ./docker/setup.sh) ================
# ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET; change all three together.
# POSTGRES_PASSWORD is fixed in the db-data volume at the first start: keep this file with the
# data. Rotating secrets: docs/self-hosting.md#rotate-secrets
POSTGRES_PASSWORD=
MANAWG_APP_DB_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
MEMBER_SESSION_SECRET=
# Rotation: copy the old MEMBER_SESSION_SECRET here, set a new one above, run `docker compose up -d`.
# Calendar feeds and unsubscribe links signed with the old secret keep working. Empty it later.
# MEMBER_SESSION_SECRET_PREVIOUS=
CRON_SECRET=

# === Optional ================================================
# Google sign-in: OAuth client from Google Cloud, redirect URI <APP_URL>/auth/v1/callback.
# The app shows the Google buttons only with GOOGLE_ENABLED=true.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
# Web Push: `npx web-push generate-vapid-keys`. The public key is built into the image, so run
# `docker compose build` after setting it (the published image has push turned off).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
