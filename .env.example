# ManaWG with Docker: settings for compose.yaml (docs/self-hosting.md).
# ./docker/setup.sh copies this file to .env and fills in the secrets. App development uses
# apps/web/.env.example instead.

# === Address =================================================
# The URL people open. Local: http://localhost (with HTTP_PORT=8080: http://localhost:8080).
APP_URL=http://localhost
# What the gateway listens on: ":80" serves plain HTTP for any host name; a domain such as
# "wg.example.com" gets HTTPS with a Let's Encrypt certificate (ports 80 and 443 reachable).
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# === Image ===================================================
# Released versions: https://github.com/Abuarchiv/manawg-app/pkgs/container/manawg-app
MANAWG_VERSION=latest

# === Mail (required) =========================================
# Sign-in codes, confirmations, invitations and statements go out over SMTP.
# Locally the "mailpit" profile catches every mail at http://localhost:8025.
COMPOSE_PROFILES=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@example.com
SMTP_SENDER_NAME=ManaWG

# === Your instance ===========================================
# Site with your /impressum, /datenschutz and /agb. Empty: links point to manawg.com, whose legal
# pages do not cover your instance. Needed as soon as people outside your household use it.
LEGAL_URL=
# Receives "Fehler per E-Mail melden". Empty: reports go to the ManaWG maintainers.
SUPPORT_EMAIL=
STORAGE_BUCKET=private-images

# === Secrets (filled in by ./docker/setup.sh) ================
# ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET; change all three together.
POSTGRES_PASSWORD=
MANAWG_APP_DB_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
MEMBER_SESSION_SECRET=
CRON_SECRET=

# === Optional ================================================
# Google sign-in: OAuth client from Google Cloud, redirect URI <APP_URL>/auth/v1/callback.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
# Web Push: `npx web-push generate-vapid-keys`. The public key is built into the image, so run
# `docker compose build` after setting it (the published image has push turned off).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
