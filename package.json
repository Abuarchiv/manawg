{
	"name": "manawg-app",
	"private": true,
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": "22.x",
		"pnpm": "9.x"
	},
	"scripts": {
		"dev": "pnpm --filter @manawg/web dev",
		"build": "pnpm --filter @manawg/web build",
		"test": "pnpm -r run test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "pnpm -r --if-present run typecheck",
		"growth:simulate": "node tools/growth-lab/index.mjs",
		"growth:refresh": "node tools/growth-lab/refresh.mjs",
		"growth:check": "node tools/growth-lab/self-check.mjs",
		"clean": "rm -rf apps/web/.next node_modules/.cache",
		"e2e": "pnpm --filter @manawg/web test:e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0"
	}
}
