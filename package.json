{
	"name": "manawg-app",
	"private": true,
	"license": "AGPL-3.0-only",
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": "22.x",
		"pnpm": "9.x"
	},
	"pnpm": {
		"overrides": {
			"postcss@8.4.31": "8.5.26",
			"brace-expansion@^5.0.8": "5.0.12",
			"source-map-js@<1.2.2": "1.2.2",
			"sharp@<0.35.5": "0.35.5",
			"dompurify@<3.4.17": "3.4.17",
			"esbuild@<0.25.0": "0.25.12"
		}
	},
	"scripts": {
		"dev": "pnpm --filter @manawg/web dev",
		"build": "pnpm --filter @manawg/web build",
		"test": "pnpm --filter @manawg/web test:unit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "pnpm -r --if-present run typecheck",
		"clean": "rm -rf apps/web/.next node_modules/.cache",
		"e2e": "pnpm --filter @manawg/web test:e2e",
		"knip": "knip"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"knip": "^6.39.0"
	}
}
